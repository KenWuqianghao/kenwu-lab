theorem witness_perm : witness.Perm (List.range' 1 17) := by decide

/-! Evaluation of `tval` without building the list of all sublists. -/

/-- The summand of `tval`: `id τ` if `|τ| ≥ 3`, else `0`. -/
def gval (τ : List ℕ) : ℕ := if 3 ≤ τ.length then idv τ else 0

/-- `subSum pre l = Σ_{x ∈ sublists l} gval (pre ++ x)`, by binary recursion on `l`. -/
def subSum (pre : List ℕ) : List ℕ → ℕ
  | [] => gval pre
  | a :: l => subSum pre l + subSum (pre ++ [a]) l

theorem subSum_eq (l pre : List ℕ) :
    subSum pre l = (l.sublists.map (fun x => gval (pre ++ x))).sum := by
  induction l generalizing pre with
  | nil => simp [subSum]
  | cons a l ih =>
    rw [subSum, ih, ih, List.sublists_cons]
    simp [List.flatMap, List.map_flatten, List.sum_flatten, Function.comp_def]

theorem tval_eq_subSum (π : List ℕ) : tval π = subSum [] π := by
  rw [subSum_eq, tval]
  simp only [List.nil_append]
  generalize π.sublists = L
  induction L with
  | nil => simp
  | cons x L ih => by_cases h : 3 ≤ x.length <;> simp [h, gval, ih]

