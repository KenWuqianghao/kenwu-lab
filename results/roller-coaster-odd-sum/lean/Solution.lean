/-- Fact (i) in one statement: the witness is a permutation of `[17]`, `t = 798783`, and
`π_4 + π_14 = 26`. -/
theorem fact_i : witness.Perm (List.range' 1 17) ∧ tval witness = 798783 ∧
    witness.getD 3 0 + witness.getD 13 0 = 26 :=
  ⟨witness_perm, witness_tval, by decide⟩

/-- The main theorem: if every Odd Sum permutation of `[17]` has `t < 798783` (fact (ii), checked by
the exact search outside Lean), then Conjecture 2.4 fails for `n = 17`. -/
theorem not_oddSumConjecture_17
    (h : ∀ σ : List ℕ, σ.Perm (List.range' 1 17) → OddSum17 σ → tval σ < 798783) :
    ¬ OddSumConjecture 17 := by
  intro hc
  set S := ((List.range' 1 17).permutations).toFinset with hS
  have hw : witness ∈ S := by
    rw [hS, List.mem_toFinset, List.mem_permutations]; exact witness_perm
  obtain ⟨π, hπ, hmax⟩ := S.exists_max_image tval ⟨witness, hw⟩
  rw [hS, List.mem_toFinset, List.mem_permutations] at hπ
  have hrc : IsRC 17 π := by
    refine ⟨hπ, fun σ hσ => hmax σ ?_⟩
    rw [hS, List.mem_toFinset, List.mem_permutations]; exact hσ
  have hodd : OddSum17 π := fun j h1 h2 => (hc π hrc).1 rfl j h1 h2
  have h1 := h π hπ hodd
  have h2 := hmax witness hw
  rw [witness_tval] at h2
  omega

